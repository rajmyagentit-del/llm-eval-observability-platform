# Copy to .env and fill in as needed. The app must run with sane defaults
# even if this file is absent — no commercial API key is required.

ENV=development
LOG_LEVEL=INFO

# Optional commercial providers (not required for core evaluation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: only needed for gated/private Hugging Face models
HUGGINGFACE_TOKEN=

# Experiment tracking - defaults to local file store if unset
MLFLOW_TRACKING_URI=

# Defaults to local SQLite if unset
DATABASE_URL=
